{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lock.schema.json",
  "title": "Gate lock file",
  "type": "object",
  "required": ["gate", "title", "status", "protects"],
  "additionalProperties": false,
  "properties": {
    "gate": { "type": "string", "pattern": "^gate-[1-5]$" },
    "title": { "type": "string" },
    "status": { "enum": ["open", "locked"] },
    "locked_at": { "type": "string" },
    "locked_by": { "type": "string" },
    "protects": { "type": "array", "items": { "type": "string" } },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "departures_at_lock": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "holdout": {
      "type": "object",
      "required": ["seed", "count", "list_sha256"],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "count": { "type": "integer", "minimum": 0 },
        "list_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "level2_waiver": {
      "type": "object",
      "required": ["share", "floor", "posture", "reason", "by", "at"],
      "additionalProperties": false,
      "properties": {
        "share": { "type": "number" },
        "floor": { "type": "number" },
        "posture": { "enum": ["strict", "observe", "own-code"] },
        "reason": { "type": "string" },
        "by": { "type": "string" },
        "at": { "type": "string" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "at", "reason"],
        "properties": {
          "action": { "enum": ["locked", "reopened"] },
          "at": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
